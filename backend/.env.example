# Backend Environment Variables Template
# Copy this to .env and fill in your actual values

# Environment (kept as NODE_ENV for continuity with existing deployments;
# only used to switch CORS between "allow any origin" in dev and a strict
# allowlist in production)
NODE_ENV=production

# Server Configuration
PORT=5000
SERVER_URL=https://your-backend-domain.onrender.com
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/flow-focus-tool?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=generate-a-strong-random-secret-key-here
JWT_EXPIRES_IN=7d

# OAuth - Google (login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# OAuth - Google (YouTube upload)
# A separate OAuth client (enable "YouTube Data API v3" in its Google Cloud
# project) with redirect URI "${SERVER_URL}/api/youtube/callback".
GOOGLE_YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id
GOOGLE_YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Cloudinary (for media uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Turnstile (Optional - for bot protection)
# If this backend's host can't reach *.cloudflare.com directly (e.g. Hugging
# Face Spaces), verification is proxied through a Vercel serverless function
# (frontend/api/turnstile-verify.js) instead of calling Cloudflare here.
# TURNSTILE_SECRET_KEY itself then lives on Vercel, not here.
TURNSTILE_PROXY_URL=https://your-frontend-domain.vercel.app/api/turnstile-verify
TURNSTILE_PROXY_SECRET=generate-a-shared-secret-matching-the-vercel-project
