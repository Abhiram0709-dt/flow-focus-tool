# Frontend Environment Variables Template
# Copy this to .env and fill in your actual values

# Backend API URL (include /api suffix)
VITE_API_URL=https://your-backend-domain.onrender.com/api

# Gemini AI API Key
VITE_GEMINI_API_KEY=your-gemini-api-key

# Gemini Live API Key (for real-time audio dialog in LivePractice)
VITE_GEMINI_LIVE_API_KEY=your-gemini-live-api-key

# Cloudflare Turnstile Site Key (Optional - for bot protection)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# --- Server-side only (used by api/turnstile-verify.js, NOT exposed to the client) ---
# Proxies Turnstile verification for the backend, when the backend's host
# can't reach Cloudflare directly (e.g. Hugging Face Spaces).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_PROXY_SECRET=generate-a-shared-secret-matching-the-backend
